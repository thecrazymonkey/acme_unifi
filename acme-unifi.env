# ACME UniFi Certificate Renewal Configuration
# Copy this file and customize for your environment

# Domain for the certificate
CERT_DOMAIN="gateway.example.com"

# Certificate UUID (from existing cert filename on your UCG Max)
# Find it with: ls /data/unifi-core/config/*.crt
# Set to "auto" to attempt auto-discovery of the active UUID
CERT_UUID="auto"

# Certificate type: "ecc" (recommended) or "rsa"
CERT_TYPE="ecc"

# ACME account email (for Let's Encrypt notifications)
ACME_EMAIL="admin@example.com"

# Renewal threshold (days before expiry to trigger renewal)
RENEWAL_DAYS=30

# Use Let's Encrypt staging server for testing (set to "true" for testing)
# Change to "false" or remove for production certificates
USE_STAGING="false"

# Log retention in days
LOG_RETENTION_DAYS=30

# Webhook URL for notifications (Slack/Discord/Healthchecks.io)
# Example: "https://hc-ping.com/your-uuid"
WEBHOOK_URL=""

# Restart unifi-core service in addition to nginx (set to "true" if needed)
RESTART_UNIFI_CORE="false"
